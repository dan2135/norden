# Copie para .env e preencha apenas no seu computador/servidor.
DB_HOST=localhost
# local (padrão) ou supabase (usa o arquivo privado .env.supabase).
DB_TARGET=local
DB_PORT=5432
DB_DATABASE=marceneiro_ia
DB_USER=postgres
DB_PASSWORD=
# Supabase: copie os parâmetros de Connect > Session pooler (porta 5432).
# Use o usuário completo mostrado lá, normalmente postgres.<referência>.
# Não use a chave pública/anon nem service_role como senha do PostgreSQL.
DB_SSL=false
# Opcional: certificado CA baixado no Supabase, caminho relativo ao backend.
DB_SSL_CA_FILE=

# ADMINISTRADOR GERAL: credenciais do painel, não do PostgreSQL.
# Preencha somente no .env privado. Leia ADMINISTRACAO.md antes de usar o script.
# Definir estas variáveis não cria conta automaticamente; ADMIN_PROVISIONAR=true aciona uma execução.
ADMIN_PROVISIONAR=false
ADMIN_USUARIO=
ADMIN_SENHA=
ADMIN_EMAIL=
# Só habilite para substituir explicitamente a senha de um administrador existente.
ADMIN_REDEFINIR=false

# Envio real: veja EMAIL-SETUP.md. Nenhuma credencial deve entrar no Git.
EMAIL_MODE=simulado
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5176

# IA: ollama mantém o comportamento local; openai usa a API paga.
IA_PROVIDER=ollama
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Assinaturas Asaas: use sandbox para testes e produção quando for cobrar clientes reais.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
NORDEN_PLANO_VALOR=9000
NORDEN_TRIAL_DIAS=30

# WhatsApp Cloud API: primeiro use o token temporário da Meta para teste.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=norden_whatsapp_2026
WHATSAPP_API_VERSION=v25.0
# Empresa que receberá as mensagens do número conectado.
WHATSAPP_MARCENARIA_SLUG=principal
WHATSAPP_MARCENARIA_ID=
